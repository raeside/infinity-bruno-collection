meta {
  name: Infinity
  seq: 1
}

auth {
  mode: inherit
}

script:pre-request {
  // JavaScript (Postman pre-request script)
  
  // ==== Configuration (Staging/Test) ====
  const DOMAIN = bru.getEnvVar('AUTH0_DOMAIN') || 'https://awn-sandbox.auth0.com';
  const CLIENT_ID = bru.getEnvVar('AUTH0_CLIENT_ID') || 'n45BWRYAOvkcsiZoLhOIM4iVAegQURPv';
  const AUDIENCE = bru.getEnvVar('AUTH0_AUDIENCE') || 'https://api.arcticwolf.com/';
  
  // ==== Configuration (Production) ====
  //const DOMAIN = pm.environment.get('AUTH0_DOMAIN') || 'https://auth.arcticwolf.com';
  //const CLIENT_ID = pm.environment.get('AUTH0_CLIENT_ID') || 'J5EVPlju43Lc0fVG8umbhBYGxTIHCLhD';
  //const AUDIENCE = pm.environment.get('AUTH0_AUDIENCE') || 'https://api.arcticwolf.com/';
  
  const SCOPES = 'openid profile email';
  const MAX_ATTEMPTS = 25; 
  const POLL_INTERVAL_FALLBACK = 5; // seconds, used if API doesn't provide interval
  
  // Environment variable names for caching
  const TOKEN_VAR = 'access_token';
  const TOKEN_EXP_VAR = 'access_token_exp'; // numeric timestamp (seconds)
  
  // ---- Helper: log to Postman Console as "user messages" ----
  function userLog(msg) {
      console.log('[AUTH0]', msg);
  }
  
  // ---- Helper: check if a cached token exists and is valid ----
  function getCachedToken() {
      const token = bru.getEnvVar(TOKEN_VAR);
      const expStr = bru.getEnvVar(TOKEN_EXP_VAR);
  
      if (!token || !expStr) {
          return null;
      }
  
      const exp = parseInt(expStr, 10);
      if (isNaN(exp)) {
          return null;
      }
  
      const now = Math.floor(Date.now() / 1000);
      if (exp <= now) {
          userLog('Cached token expired; will re-authenticate.');
          // Clear invalid token
          bru.deleteEnvVar(TOKEN_VAR);
          bru.deleteEnvVar(TOKEN_EXP_VAR);
          return null;
      }
  
      userLog('Using cached token from environment.');
      return token;
  }
  
  // ---- Helper: decode JWT payload (without verification) ----
  function decodeJwtPayload(token) {
      try {
          const parts = token.split('.');
          if (parts.length !== 3) {
              return null;
          }
          const payload = parts[1];
          const padded = payload.replace(/-/g, '+').replace(/_/g, '/')
              .padEnd(Math.ceil(payload.length / 4) * 4, '=');
          const jsonStr = Buffer.from(padded, 'base64').toString('utf8');
          return JSON.parse(jsonStr);
      } catch (e) {
          userLog('Failed to decode JWT payload: ' + e);
          return null;
      }
  }
  
  // ---- Helper: store token and expiry in environment ----
  function cacheToken(token) {
      const payload = decodeJwtPayload(token);
      let exp = null;
  
      if (payload && typeof payload.exp === 'number') {
          exp = payload.exp;
          userLog('Token exp (from JWT): ' + exp);
      }
  
      // If no exp in JWT, fall back to a short lifetime (e.g., 1 hour from now)
      if (!exp) {
          const now = Math.floor(Date.now() / 1000);
          exp = now + 3600;
          userLog('No exp in JWT, using synthetic expiry: ' + exp);
      }
  
      bru.setEnvVar(TOKEN_VAR, token);
      bru.setEnvVar(TOKEN_EXP_VAR, exp.toString());
  
      const email = payload && payload['https://rtkwlf.io/email'] ? payload['https://rtkwlf.io/email'] : 'unknown';
      userLog('Cached token in environment for AWN email: ' + email);
  }
  
  // ---- Main: try cached token first ----
  const cachedToken = getCachedToken();
  if (cachedToken) {
      // Nothing else to do; next request can use {{access_token}}
      return;
  }
  
  // ---- No valid cached token: start Device Code flow ----
  userLog('No valid cached token; starting Auth0 Device Code flow.');
  
  // 1. Request device code
  await bru.sendRequest({
      url: DOMAIN + '/oauth/device/code',
      method: 'POST',
      headers: { "Content-Type": "application/x-www-form-urlencoded" },
      data: {
          "client_id": CLIENT_ID,
          "scope": SCOPES,
          "audience": AUDIENCE
      },
      timeout: 180000
  }, async function(err, res) {
      if (err) {
          userLog('Error starting device authorization: ' + err);
          throw new Error('Could not start authentication against ' + DOMAIN);
      }
  
      if (!res || res.status < 200 || res.status >= 300) {
          userLog('Non-OK response: ' + res.status);
          userLog(JSON.stringify(res.data, null, 2));
          throw new Error('Could not start authentication against ' + DOMAIN);
      }
  
      const codeResponse = res.data;
  
      const userCode = codeResponse.user_code;
      const verificationUriComplete = codeResponse.verification_uri_complete || codeResponse.verification_uri;
      const interval = (codeResponse.interval || POLL_INTERVAL_FALLBACK); // seconds
      const deviceCode = codeResponse.device_code;
  
      userLog('Please open this URL and complete login:');
      userLog(verificationUriComplete);
      userLog('Use user code: ' + userCode);
      userLog('Polling Auth0 every ' + interval + ' seconds (up to ' + MAX_ATTEMPTS + ' times).');
  
      // 2. Poll for token
      let attempts = 0;
  
      function pollForToken() {
          attempts += 1;
          if (attempts > MAX_ATTEMPTS) {
              userLog('Authentication timed out after ' + MAX_ATTEMPTS + ' attempts.');
              throw new Error('Authentication timed out after ' + MAX_ATTEMPTS + ' attempts.');
          }
  
          //userLog('Waiting for authentication... attempt ' + attempts + '/' + MAX_ATTEMPTS);
  
          await bru.sendRequest({
              url: DOMAIN + '/oauth/token',
              method: 'POST',
              headers: { "Content-Type": "application/x-www-form-urlencoded" },
              data: {
                  "grant_type": 'urn:ietf:params:oauth:grant-type:device_code',
                  "device_code": deviceCode,
                  "client_id": CLIENT_ID
              },
              timeout: 180000
          }, async function(err2, res2) {
              if (err2) {
                  userLog('Error polling token endpoint: ' + err2);
                  throw new Error('Failed to authenticate: ' + err2);
              }
  
              if (res2.status >= 200 && res2.status < 300) {
                  const body = res2.data;
                  const accessToken = body.access_token;
  
                  if (!accessToken) {
                      userLog('No access_token in response.');
                      throw new Error('No access token in Auth0 response.');
                  }
  
                  cacheToken(accessToken);
  
                  const payload = decodeJwtPayload(accessToken) || {};
                  const email = payload['https://rtkwlf.io/email'] || 'unknown';
                  userLog('Logged in to AWN as ' + email + ' (token stored as environment variable ' + TOKEN_VAR + ').');
                  // Done: subsequent request will see {{access_token}}
                  return;
              }
  
              const errorBody = res2.data || {};
              const error = errorBody.error;
  
              if (error && error !== 'authorization_pending') {
                  userLog('Authentication failed: ' + error);
                  throw new Error('Failed to authenticate: ' + error);
              }
  
              // authorization_pending: schedule another poll after interval seconds
              setTimeout(pollForToken, interval * 1000);
          });
      }
  
      // Start polling
      setTimeout(pollForToken, interval * 1000);
  });
  
}
